# Runtime
APP_ENVIRONMENT=Development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
LOG_LEVEL=Information

# PostgreSQL (local placeholders only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=studyai
POSTGRES_USER=studyai_app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://studyai_app:change-me-local-only@localhost:5432/studyai
STUDYAI_TEST_DATABASE_URL=postgresql://studyai_test:change-me-local-only@localhost:5432/studyai_test

# Private S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=local
OBJECT_STORAGE_BUCKET=studyai-private
OBJECT_STORAGE_ACCESS_KEY=change-me-local-only
OBJECT_STORAGE_SECRET_KEY=change-me-local-only
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Authentication placeholders; final architecture is OPEN
AUTH_ISSUER=https://replace-with-authorized-issuer.example
AUTH_AUDIENCE=studyai-api
AUTH_CLIENT_ID=replace-with-client-id
AUTH_CLIENT_SECRET=replace-with-secret

# AI gateway placeholders; provider/model choices are OPEN
AI_PROVIDER=replace-with-provider
AI_API_BASE_URL=https://replace-with-provider-endpoint.example
AI_API_KEY=replace-with-secret
AI_CHAT_MODEL=replace-with-evaluated-model
AI_EMBEDDING_MODEL=replace-with-evaluated-model

# Background jobs; implementation is OPEN
JOB_QUEUE_PROVIDER=replace-with-approved-provider

# Payments; provider and commercial policy are OPEN
PAYMENT_PROVIDER=replace-with-provider
PAYMENT_WEBHOOK_SECRET=replace-with-secret

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
