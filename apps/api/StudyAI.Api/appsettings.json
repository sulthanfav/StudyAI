{
  "Foundation": {
    "ServiceName": "StudyAI.Api",
    "MaxCorrelationIdLength": 64
  },
  "Authentication": {
    "Sessions": {
      "IdleLifetimeSeconds": 28800,
      "StandardAbsoluteLifetimeSeconds": 28800,
      "RememberMeAbsoluteLifetimeSeconds": 2592000
    },
    "RateLimits": {
      "Register": {
        "PermitLimit": 5,
        "WindowSeconds": 3600
      },
      "Login": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      }
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
